{
    "name": "directorium/api",
    "description": "The Directorium API: a versioned, cache-first HTTP service over the liturgical engine.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "directorium/core": "dev-develop"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Introibo-App/Core"
        }
    ],
    "autoload": {
        "psr-4": {
            "Directorium\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Directorium\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "lint": "Check coding standards (PSR-12) with PHP_CodeSniffer.",
        "lint:fix": "Auto-fix coding-standard violations with phpcbf.",
        "analyse": "Run PHPStan static analysis at the configured level.",
        "test": "Run the PHPUnit test suite.",
        "check": "Run all quality gates locally (lint + analyse + test)."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
